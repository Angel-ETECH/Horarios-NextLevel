# ============================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ============================================

APP_NAME="Academia Next Level School"
APP_ENV=local
APP_KEY=base64:peDFVqVbL47AFmz1wOQGrM9TeimsXqxrClBruwwXnQQ=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

# ============================================
# CONFIGURACIÓN DE SERVIDOR
# ============================================

SERVER_PORT=8000
SERVER_HOST=127.0.0.1

# ============================================
# SEGURIDAD Y HASH
# ============================================

BCRYPT_ROUNDS=12
HASH_DRIVER=bcrypt

# ============================================
# CONFIGURACIÓN DE LOGS
# ============================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS (MySQL)
# ============================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=horarios_next_level
DB_USERNAME=root
DB_PASSWORD=jhosep_582006
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT=true
DB_ENGINE=InnoDB

# ============================================
# CONFIGURACIÓN DE CACHE Y SESIÓN
# ============================================

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
CACHE_DRIVER=file
CACHE_STORE=database

# ============================================
# CONFIGURACIÓN DE SANCTUM (API Authentication)
# ============================================

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ============================================
# CONFIGURACIÓN DE COLAS (UNIFICADA)
# ============================================

QUEUE_CONNECTION=database

# ============================================
# CONFIGURACIÓN REDIS (Opcional)
# ============================================

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ============================================
# CONFIGURACIÓN DE EMAIL
# ============================================

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Academia Next Level School"

# ============================================
# CONFIGURACIÓN AWS (Opcional)
# ============================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# CONFIGURACIÓN DE ASSETS (Frontend)
# ============================================

MIX_ASSET_URL=/
ASSET_URL=/
VITE_APP_NAME="Academia Next Level School"

# ============================================
# CONFIGURACIÓN ESPECÍFICA DEL PROYECTO
# ============================================

HORARIO_INICIO_CLASES=07:00
HORARIO_FIN_CLASES=18:30
DURACION_BLOQUE_MINUTOS=45
MAX_HORAS_CONTINUAS=4
TIEMPO_DESCANSO_MINUTOS=15
CARGA_HORARIA_MAXIMA=30
CARGA_HORARIA_MINIMA=8
DIAS_LABORALES=1,2,3,4,5,6
CAPACIDAD_AULA_DEFAULT=30

# ============================================
# CONFIGURACIÓN DE EXPORTACIÓN
# ============================================

EXPORT_EXCEL_DRIVER=maatwebsite
EXPORT_PDF_DRIVER=dompdf
EXPORT_IMAGE_QUALITY=90

# ============================================
# CONFIGURACIÓN DE WHATSAPP
# ============================================

WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_API_TOKEN=tu_token_aqui

# ============================================
# CONFIGURACIÓN DE CORS
# ============================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-CSRF-TOKEN
CORS_MAX_AGE=86400

# ============================================
# DEBUG Y MONITOREO
# ============================================

DEBUGBAR_ENABLED=true
TELESCOPE_ENABLED=true
